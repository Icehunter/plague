#version 450

// RGB is the selected source's importance-weighted visibility; signed alpha is history age.
// Positive means answered this frame; negative means held history, unavailable to handoff.
// The weight image must come from the same seed dispatch as the ray request it accompanies.
#define PLAGUE_LOCAL_SHADOWS 0 //[0 1] compile "Traced Block Light" {0="Off" 1="On"}
#define FORNAX_COMPUTE_GLOBALS
#define FORNAX_GLOBALS_BINDING 0
#moj_import <fornax:globals.glsl>
#moj_import <fornax_runtime:gi_grid.glsl>
#moj_import <fornax_runtime:geometric_normal.glsl>
#moj_import <fornax_runtime:local_light_handoff.glsl>
#moj_import <fornax:ray_answer.glsl>

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, set = 0, binding = 2) readonly buffer GiLightRequests { vec4 words[]; } rays;
layout(std430, set = 0, binding = 3) readonly buffer GiLightHits { uint words[]; } hits;
layout(set = 0, binding = 4) uniform sampler2D u_Depth;
layout(set = 0, binding = 5) uniform sampler2D u_GNormal;
layout(set = 0, binding = 6) uniform sampler2D u_Motion;
layout(rgba32f, set = 0, binding = 7) uniform readonly image2D u_History;
layout(rgba16f, set = 0, binding = 8) uniform readonly image2D u_SurfaceHistory;
// Appended input moves only the output binding; earlier inputs retain their ABI positions.
layout(rgba32f, set = 0, binding = 9) uniform readonly image2D u_GiLightWeight;
layout(rgba32f, set = 0, binding = 10) uniform writeonly image2D u_Out;

#define PLAGUE_GI_HISTORY_DEPTH u_Depth
#define PLAGUE_GI_HISTORY_NORMAL u_GNormal
#define PLAGUE_GI_HISTORY_MOTION u_Motion
#define PLAGUE_GI_HISTORY_SURFACE u_SurfaceHistory
#moj_import <fornax_runtime:gi_history_test.glsl>

// Fornax ray-answer ABI, in 32-bit words.
const uint PLAGUE_GI_HIT_WORDS = 9u;
const uint PLAGUE_GI_WORD_DISTANCE = 0u;
const uint PLAGUE_GI_WORD_TIER = 7u;
// Existing traced-light window: twice the voxel window for one ray per coarse grid cell.
const float PLAGUE_GI_VIS_FRAMES = 24.0;

vec4 plagueLocalRtHistory(ivec2 cell,ivec2 size) {
    vec4 previous=imageLoad(u_History,clamp(cell,ivec2(0),size-1));
    // The sign reports current availability, not negative sample count. Strip it per donor
    // before interpolation so a held neighbour cannot cancel an answered neighbour's age.
    previous.a=abs(previous.a);
    return previous;
}

void main() {
    ivec2 size=imageSize(u_Out);
    ivec2 cell=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(cell,size))) return;
    vec2 uv=plagueGiDepthUv(plagueGiCellUv(vec2(cell),vec2(size)),textureSize(u_Depth,0));
    uint index=uint(cell.y*size.x+cell.x);
    float depth=texture(u_Depth,uv).r;
    vec4 packed=texture(u_GNormal,uv);
    vec3 normal=dot(packed.xyz,packed.xyz)>1e-6
            ? plagueDecodeGeometricNormal(packed.a,normalize(packed.xyz)) : vec3(0.0);
    if(depth<=0.0 || dot(normal,normal)<=1e-6) {
        imageStore(u_Out,cell,vec4(1.0,1.0,1.0,0.0));
        return;
    }
    if(plagueLocalRtPreference(plagueGiHistoryPosition(uv,depth))<=0.0) {
        imageStore(u_Out,cell,vec4(1.0,1.0,1.0,0.0));
        return;
    }
    ivec2 corner; vec4 historyWeights;
    float kept=plagueGiHistoryWeights(uv,depth,normal,size,corner,historyWeights);
    vec4 previous=vec4(1.0,1.0,1.0,0.0);
    if(kept>0.0) previous=(plagueLocalRtHistory(corner,size)*historyWeights.x
            +plagueLocalRtHistory(corner+ivec2(1,0),size)*historyWeights.y
            +plagueLocalRtHistory(corner+ivec2(0,1),size)*historyWeights.z
            +plagueLocalRtHistory(corner+ivec2(1,1),size)*historyWeights.w)/kept;
    vec4 weight=imageLoad(u_GiLightWeight,cell);
    if(weight.a==0.0) {
        // No selected source carries no new evidence. Age zero leaves a fresh cell eligible
        // for voxel fallback instead of certifying an untraced segment as transparent.
        imageStore(u_Out,cell,vec4(previous.rgb,-abs(previous.a)));
        return;
    }
    vec3 current=vec3(0.0);
    if(weight.a>0.0) {
        uint base=index*PLAGUE_GI_HIT_WORDS;
        if(int(hits.words[base+PLAGUE_GI_WORD_TIER])==FORNAX_RAY_TIER_NONE) {
            imageStore(u_Out,cell,vec4(previous.rgb,-abs(previous.a)));
            return;
        }
        if(uintBitsToFloat(hits.words[base+PLAGUE_GI_WORD_DISTANCE])<0.0) current=weight.rgb;
    }
    // Negative weight alpha is a valid zero-energy direct path delegated to dielectric
    // transport. Treating it as missing would retain direct light and double-count the caustic.
    float gathered=min(abs(previous.a)+1.0,PLAGUE_GI_VIS_FRAMES);
    imageStore(u_Out,cell,vec4(mix(previous.rgb,current,1.0/gathered),gathered));
}
