#version 450
#define PLAGUE_GI 0 //[0 1] compile "Bounce Light (Experimental)" {0="Off" 1="On"}
#define FORNAX_COMPUTE_GLOBALS
#define FORNAX_GLOBALS_BINDING 0
#moj_import <fornax:globals.glsl>
#moj_import <fornax_runtime:glass_options.glsl>
#moj_import <fornax_runtime:shadow_options.glsl>
#moj_import <fornax_runtime:glass_photons.glsl>
#moj_import <fornax_runtime:color.glsl>
#moj_import <fornax_runtime:brdf.glsl>
#moj_import <fornax_runtime:geometric_normal.glsl>
#moj_import <fornax_runtime:glass_receiver_grid.glsl>
#moj_import <fornax_runtime:glass_photon_cache.glsl>
#moj_import <fornax_runtime:glass_sun_grid.glsl>
#moj_import <fornax_runtime:glass_beam.glsl>
#moj_import <fornax_runtime:glass_beam_index.glsl>
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=2) uniform sampler2D u_Depth;
layout(set=0,binding=3) uniform sampler2D u_GNormal;
layout(set=0,binding=4) uniform sampler2D u_GAlbedo;
layout(std430,set=0,binding=5) readonly buffer GlassPhotons { vec4 photonWords[]; };
layout(std430,set=0,binding=6) readonly buffer GlassHeads { uint headWords[]; };
layout(std430,set=0,binding=7) readonly buffer GlassLinks { uvec4 linkWords[]; };
// Appended cache input; GI adds five earlier inputs, preserving their positions.
#if PLAGUE_GI != 0
#define PLAGUE_GLASS_MEDIUM_BINDING 27
#define PLAGUE_GLASS_CELL_BINDING 29
#else
#define PLAGUE_GLASS_MEDIUM_BINDING 22
#define PLAGUE_GLASS_CELL_BINDING 24
#endif
#define PLAGUE_GLASS_BINDING_START 8
#moj_import <fornax_runtime:glass_compute_scene.glsl>
#moj_import <fornax_runtime:glass_beam_visibility.glsl>
layout(set=0,binding=15) uniform sampler2D u_GMaterial;
layout(std430,set=0,binding=16) readonly buffer GlassCache { uint cacheWords[]; };
layout(std430,set=0,binding=17) readonly buffer GlassBeams { vec4 beamWords[]; };
#if PLAGUE_GI != 0
layout(std430,set=0,binding=22) readonly buffer GiPhotonWords { vec4 giPhotonWords[]; };
layout(std430,set=0,binding=23) readonly buffer GiPhotonHeads { uint giPhotonHeads[]; };
layout(std430,set=0,binding=24) readonly buffer GiPhotonLinks { uint giPhotonLinks[]; };
layout(std430,set=0,binding=25) readonly buffer GiPhotonBeams { vec4 giPhotonBeams[]; };
layout(rgba32f,set=0,binding=26) uniform readonly image2D u_IndirectHistoryPrevious;
#define giPhotonCache cacheWords
#moj_import <fornax_runtime:glass_camera_indirect.glsl>
#define PLAGUE_GLASS_GATHER_OUTPUT_SHIFT 8
#else
#define PLAGUE_GLASS_GATHER_OUTPUT_SHIFT 3
#endif
layout(rgba16f,set=0,binding=22+PLAGUE_GLASS_GATHER_OUTPUT_SHIFT) uniform writeonly image2D u_Local;
layout(rgba16f,set=0,binding=23+PLAGUE_GLASS_GATHER_OUTPUT_SHIFT) uniform writeonly image2D u_Sun;
layout(rgba16f,set=0,binding=28+PLAGUE_GLASS_GATHER_OUTPUT_SHIFT) uniform writeonly image2D u_GlossyCurrent;
layout(rgba16f,set=0,binding=29+PLAGUE_GLASS_GATHER_OUTPUT_SHIFT) uniform writeonly image2D u_IndirectCurrent;
layout(rgba32f,set=0,binding=30+PLAGUE_GLASS_GATHER_OUTPUT_SHIFT) uniform writeonly image2D u_IndirectHistory;

uint plagueGlassCameraCacheWord(int word) { return cacheWords[word]; }
int plagueGlassCameraCacheSize() { return cacheWords.length(); }
#moj_import <fornax_runtime:glass_camera_specular.glsl>
#moj_import <fornax_runtime:glass_glossy_history.glsl>

bool plagueGlassSunDomain(vec3 point,vec3 light,out float sourceDistance) {
#ifndef SHADOWS
    sourceDistance=0.0;
    return false; // No sun photons were certified against the absent raster shadow map.
#else
    // Match the photon launch plane and leave a full kernel inside its footprint. Outside this
    // finite domain no sampled path can replace straight sunlight, so keep the existing lighting.
    vec3 tangent,bitangent; ivec2 first; float plane;
    plagueGlassSunGrid(light,tangent,bitangent,first,plane);
    float inner=PLAGUE_GLASS_SUN_RADIUS-PLAGUE_GLASS_GATHER_RADIUS;
    vec3 absolute=point+u_CameraAbs;
    vec2 centre=(vec2(first)+float(PLAGUE_GLASS_SUN_GRID_SIZE)/2.0)*PLAGUE_GLASS_SUN_CELL;
    sourceDistance=plane-dot(absolute,light);
    // Fornax dimension IDs: 1 is the Overworld; 0 is unknown.
    return light.y>0.0 && u_WorldBounds.w==1.0
        && abs(dot(absolute,tangent)-centre.x)<inner && abs(dot(absolute,bitangent)-centre.y)<inner
        && sourceDistance>PLAGUE_GLASS_EPSILON && sourceDistance<PLAGUE_GLASS_SUN_RADIUS*3.0;
#endif
}
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy),size=imageSize(u_Local);
    if(gl_LocalInvocationIndex==0u) plagueGlassGlossyFrameAccepted=plagueGlassGlossyFrameReady(size)?1u:0u;
    barrier();
    plagueGlassGlossyPublishState(pixel);
    if(any(greaterThanEqual(pixel,size))) return;
    vec4 indirectHistory=vec4(0.0);
    // Keep lane validity as an integer mask. Native Metal replay lost valid history accumulation
    // in whole SIMD groups with the equivalent bool short-circuit chain. Explicit bitwise
    // accumulation preserved the same valid/unknown decisions in that replay; live Vulkan
    // behavior remains a separate check rather than proof of the same compiler failure.
    uint indirectAvailable=0u;
    vec4 glossyHistory=vec4(0.0),glossySurface=vec4(0.0),glossySignature=vec4(0.0);
    ivec2 fullSize=textureSize(u_Depth,0);
    ivec2 sourcePixel=plagueGlassReceiverTexel(pixel,size,fullSize);
    // Depth belongs to a full-resolution texel centre; a half-texel ray offset can exceed the
    // geometric plane tolerance. The 0.5 offset is the raster pixel-centre convention.
    vec2 sourceUv=(vec2(sourcePixel)+0.5)/vec2(fullSize);
    float depth=texelFetch(u_Depth,sourcePixel,0).r;
    vec4 packed=texelFetch(u_GNormal,sourcePixel,0);
    vec3 local=vec3(0.0),sun=vec3(0.0);
    float directSun=1.0;
    if(depth>0.0 && dot(packed.xyz,packed.xyz)>0.0) {
        vec4 world=u_InvProjModelView*vec4(sourceUv*2.0-1.0,depth,1.0);
        vec3 point=world.xyz/world.w,normal=normalize(packed.xyz);
        vec3 cacheOrigin=vec3(ivec3(cacheWords[4],cacheWords[5],cacheWords[6]));
        vec3 transportPoint=point+(u_CameraAbs-cacheOrigin);
        vec3 geometric=plagueDecodeGeometricNormal(packed.a,normal),view=normalize(-point);
        vec3 albedo=plagueSrgbToLinear(texelFetch(u_GAlbedo,sourcePixel,0).rgb);
        vec3 encoded=texelFetch(u_GMaterial,sourcePixel,0).rgb;
        PlagueMaterial material=plagueDecodeMaterial(encoded.r,encoded.g,encoded.b);
        vec3 cacheOffset=cacheOrigin-u_CameraAbs;
        glossySurface=packed;
        glossySignature.xyz=vec3(plagueGlassGlossyRgb24(encoded),
            plagueGlassGlossyRgb24(texelFetch(u_GAlbedo,sourcePixel,0).rgb),depth);
        vec4 previous=imageLoad(u_GlossyHistoryPrevious,pixel);
        vec4 previousSignature=imageLoad(u_GlossySignaturePrevious,pixel);
        bool reuse=plagueGlassGlossyReceiverReady(previous,
            imageLoad(u_GlossySurfacePrevious,pixel),previousSignature,packed,glossySignature.xyz,transportPoint);
        // The engine frame counter wraps at 720720. Rejected history must still draw a
        // new camera batch: restarting at zero repeats the same BRDF rays under TAA.
        // At the maximum eight-ray tier, frame ordinal plus batch remains below 2^24,
        // so the signature retains exact float32 integers. Accepted history is unchanged.
        float sequence=reuse?previousSignature.w:
            float((uint(u_FrameState.x)%720720u)*uint(PLAGUE_GLASS_GLOSSY_SAMPLES));
        uint pixelKey=plagueGlassHash(uint(sourcePixel.x)^plagueGlassHash(uint(sourcePixel.y)));
        vec3 glossySum=vec3(0.0);
        bool glossyAvailable=true;
        vec3 indirectSum=vec3(0.0);
        indirectAvailable=1u;
        for(int lane=0;lane<PLAGUE_GLASS_GLOSSY_SAMPLES;++lane) {
            uint state=plagueGlassHash(pixelKey^plagueGlassHash(uint(sequence)+uint(lane)+1u));
            vec3 sampleRadiance;
            int answer=plagueGlassCameraSpecularSequence(point,normal,geometric,view,material,albedo,
                state,PLAGUE_GLASS_INTERFACES,pixelKey,uint(sequence)+uint(lane),sampleRadiance);
            if(answer<0) glossyAvailable=false;
            else glossySum+=sampleRadiance;
            indirectAvailable &= uint(answer>=0) & uint(plagueGlassCameraIndirectAvailable);
            indirectSum+=plagueGlassCameraIndirect;
        }
        if(glossyAvailable) {
            glossyHistory=plagueGlassGlossyAccumulate(reuse?previous:vec4(0.0),glossySum);
            glossySignature.w=sequence+float(PLAGUE_GLASS_GLOSSY_SAMPLES);
        }
#if PLAGUE_GI != 0
        if(indirectAvailable!=0u) {
            vec4 previousIndirect=imageLoad(u_IndirectHistoryPrevious,pixel);
            bool indirectReuse=reuse && plagueGlassGlossyFinite(previousIndirect)
                && all(greaterThanEqual(previousIndirect,vec4(0.0)))
                && previousIndirect.a<=PLAGUE_GLASS_GLOSSY_HISTORY_SAMPLES
                && previousIndirect.a==floor(previousIndirect.a);
            indirectHistory=plagueGlassGlossyAccumulate(indirectReuse?previousIndirect:vec4(0.0),indirectSum);
        }
#else
        indirectAvailable=0u;
#endif
        // Unavailable resets count/sequence and keeps the entire original photon glossy. Neither
        // answered-only camera averages nor photon fallback enter the camera radiance history.
        PlagueGlassMedium receiverMedium;
        bool receiverMediumReady=false;
        int topLevel=plagueGlassBeamTopLevel(fullSize);
        // Receiver normal is invariant across hierarchy levels. Preserve every bank
        // accepted by the original predicate and visit its set bits in ascending order.
        uint supportedBanks=1u;
        for(uint bank=1u;bank<7u;++bank)
            if(plagueGlassNormalBankSupported(bank,geometric)) supportedBanks|=1u<<bank;
        for(int level=0;level<=topLevel;++level) {
            ivec3 key=plagueGlassBeamCell(sourcePixel,level);
            // Generic records plus every exact axis passing the original dot test. Disjoint
            // banks prevent duplicate contributions; spatial hierarchy and node ownership stay intact.
            // Normal buckets are disjoint equal-width banks over the same cell hash.
            uint cellBucket=plagueGlassBeamNormalBucket(key,0u);
            for(uint banks=supportedBanks;banks!=0u;banks&=banks-1u) {
                uint bank=uint(findLSB(banks));
                uint node=headWords[cellBucket+bank*(PLAGUE_GLASS_BEAM_INDEX_HEADS/PLAGUE_GLASS_NORMAL_BANKS)];
                // Each photon has at most four nodes. Exact keys reject collisions without dropping energy.
                for(uint visit=0u;node!=0u && visit<PLAGUE_GLASS_PHOTONS*PLAGUE_GLASS_BEAM_LINKS_PER_PHOTON;++visit) {
                    if(node>PLAGUE_GLASS_PHOTONS*PLAGUE_GLASS_BEAM_LINKS_PER_PHOTON) break;
                    uvec4 link=linkWords[node-1u];
                    uint index=(node-1u)/PLAGUE_GLASS_BEAM_LINKS_PER_PHOTON;
                    node=link.x;
                    if(any(notEqual(ivec3(link.yzw),key))) continue;
                    if(index>=PLAGUE_GLASS_PHOTONS) break;
                    uint base=index*PLAGUE_GLASS_PHOTON_WORDS;
                    vec3 p=photonWords[base].xyz;
                    vec3 difference=p-transportPoint;
                    vec3 receiverNormal=photonWords[base+3u].xyz;
                    uint beamBase=index*PLAGUE_GLASS_BEAM_WORDS;
                    // Axis banks were certified by the exact signed-axis predicate above.
                if((bank==0u && dot(receiverNormal,geometric)<0.99) || abs(dot(difference,geometric))>PLAGUE_GLASS_EPSILON*8.0) continue;
                    float distanceSquared=dot(difference,difference);
                    if(distanceSquared>=PLAGUE_GLASS_GATHER_RADIUS*PLAGUE_GLASS_GATHER_RADIUS) continue;
                    vec4 energy=photonWords[base+1u];
                    // The production BRDF has exactly zero conductor diffuse. Once camera glossy
                    // owns this local lobe, skip obsolete local beam visibility; sun still needs it.
                    if(energy.a<=0.0 && glossyAvailable && material.metalness==1.0) continue;
                    vec3 incoming=photonWords[base+2u].xyz;
                    float cosine=max(dot(normal,incoming),0.0);
                    float geometricCosine=max(dot(geometric,incoming),0.0);
                    if(cosine<=0.0 || geometricCosine<=0.0) continue;
                    if(beamWords[beamBase+5u].w==-2.0 && !plagueGlassBeamLastLegVisible(
                            plagueGlassBoundaryOffset(point,geometric,geometric),incoming,beamWords[beamBase+6u],
                            beamWords[beamBase+7u].xyz,beamWords[beamBase+8u].xyz,cacheOffset,
                            (int(beamWords[beamBase+9u].w)&65536)!=0)) continue;
                    PlagueBrdf response=plagueEvaluateBrdf(material,albedo,normal,view,incoming);
                    vec3 glossy=(energy.a>0.0 || !glossyAvailable)?response.specular:vec3(0.0);
                    vec3 bsdf=(response.diffuse*albedo+glossy)/geometricCosine;
                    vec3 contribution=bsdf*energy.rgb*plagueGlassKernel(distanceSquared);
                    if(energy.a>0.0) sun+=contribution; else local+=contribution;
                }
            }
        }
        vec3 sunDirection=-normalize(vec3(u_SunViewProj[0][2],u_SunViewProj[1][2],u_SunViewProj[2][2]));
        float sunReach;
        if(dot(geometric,sunDirection)>0.0 && plagueGlassSunDomain(point,sunDirection,sunReach)
                && plagueGlassSegmentIntersects(point+geometric*PLAGUE_GLASS_EPSILON*2.0,
                    sunDirection,sunReach)) directSun=0.0;
    }
    imageStore(u_GlossyHistory,pixel,glossyHistory);
    imageStore(u_GlossySurface,pixel,glossySurface);
    imageStore(u_GlossySignature,pixel,glossySignature);
    imageStore(u_IndirectHistory,pixel,indirectHistory);
    imageStore(u_IndirectCurrent,pixel,vec4(indirectHistory.rgb,float(indirectAvailable)));
    imageStore(u_Local,pixel,vec4(local,directSun));
    imageStore(u_Sun,pixel,vec4(sun,1.0));
    imageStore(u_GlossyCurrent,pixel,vec4(glossyHistory.rgb,1.0));
}
