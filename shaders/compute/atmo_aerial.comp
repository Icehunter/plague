#version 450

// The aerial-perspective table: for each screen froxel (32 x 32 across the frame, 32 depth
// slices quadratic to twice the render distance), what the air between the camera and that depth
// scatters toward the eye and what it lets through, lit by the true sun and the moon opposite it,
// with the fog drive's mist as a shallow layer. Two more slices carry the sky along each froxel's
// ray and this frame's per-channel transmittance exponent, so a consumer needs one texture. See
// atmo_lut.glsl for the layout and the readers.

#moj_import <fornax_runtime:atmo_transport_compute.glsl>

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rgba16f, set = 0, binding = 9) uniform writeonly image2D u_OutAerial;

void main() {
    ivec2 size = imageSize(u_OutAerial);
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, size))) {
        return;
    }
    int slice = texel.x / PLAGUE_ATMO_AERIAL_GRID;
    ivec2 cell = ivec2(texel.x - slice * PLAGUE_ATMO_AERIAL_GRID, texel.y);

    // The froxel's ray, reconstructed exactly the way the resolve reconstructs a pixel's: at a
    // far-but-finite reversed-Z depth so view bob stays negligible against the distance.
    vec2 ndc = (vec2(cell) + 0.5) / float(PLAGUE_ATMO_AERIAL_GRID) * 2.0 - 1.0;
    vec4 worldH = u_InvProjModelView * vec4(ndc, 0.0001, 1.0);
    vec3 dir = normalize(worldH.xyz / worldH.w);

    vec3 sunDir = plagueAtmoComputeSunDirection();
    float r = plagueAtmoCameraRadius();
    float rain = clamp(u_SkyState.x, 0.0, 1.0);
    float thunder = clamp(u_FrameState.z, 0.0, 1.0);

    // The debug probe rides in the alpha channel of the unused metadata pages; RGB and every
    // transport slice keep their normal values. This needs no new texture in resolve and no new
    // data in the geometry ABI.
    vec2 shadowProbe = vec2(1.0, 0.0);
#if PLAGUE_AIR_SHADOW_DEBUG && defined(SHADOWS)
    if (slice == PLAGUE_ATMO_AERIAL_SKY_SLICE || slice == PLAGUE_ATMO_AERIAL_CHROMA_SLICE) {
        vec3 lightDir = plagueAtmoShadowLightDirection();
        if (dot(lightDir, lightDir) > 0.0) {
            shadowProbe = plagueAtmoShadowAt(dir * u_AirShadowProbeDistance, lightDir);
        }
    }
#endif
    if (slice == PLAGUE_ATMO_AERIAL_SKY_SLICE) {
        vec4 sky = plagueAtmoSkyView(dir, sunDir, r);
#if PLAGUE_AIR_SHADOW_DEBUG
        sky.a = shadowProbe.x;
#endif
        imageStore(u_OutAerial, texel, sky);
        return;
    }

    PlagueAtmoAir air = plagueAtmoComputeAir(sunDir, rain, thunder);

    if (slice == PLAGUE_ATMO_AERIAL_CHROMA_SLICE) {
        // Flat in the End: distance there changes how much you see, never what colour it is, so
        // there is no per-colour reddening for this slice to carry.
        vec3 chroma = u_WorldBounds.w == 3.0
                ? vec3(1.0)
                : plagueAtmoTransmittanceChroma(r - PLAGUE_PLANET_RADIUS, air);
        imageStore(u_OutAerial, texel, vec4(chroma,
#if PLAGUE_AIR_SHADOW_DEBUG
                                          shadowProbe.y
#else
                                          1.0
#endif
                                          ));
        return;
    }

    float sliceBlocks = plagueAtmoAerialSliceDepth(slice, plagueAtmoAerialFar());
    imageStore(u_OutAerial, texel, plagueAtmoComputeTransport(dir, sunDir, r, air, sliceBlocks));
}
