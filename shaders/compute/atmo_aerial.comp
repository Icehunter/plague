#version 450

// The aerial-perspective table: for each screen froxel (32 x 32 across the frame, 32 depth
// slices quadratic to twice the render distance), what the air between the camera and that depth
// scatters toward the eye and what it lets through, lit by the true sun and the moon opposite it,
// with the fog drive's mist as a shallow layer. Two more slices carry the sky along each froxel's
// ray and this frame's per-channel transmittance exponent, so a consumer needs one texture. See
// atmo_lut.glsl for the layout and the readers.

#define FORNAX_COMPUTE_GLOBALS
#define FORNAX_GLOBALS_BINDING 0
#moj_import <fornax:globals.glsl>
#moj_import <fornax_runtime:light_and_ambient_colors.glsl>
#moj_import <fornax_runtime:light_options.glsl>
#moj_import <fornax_runtime:fog_options.glsl>
#moj_import <fornax_runtime:sky.glsl>
#moj_import <fornax_runtime:fog_model.glsl>
#define PLAGUE_ATMO_READS_TRANSMITTANCE
#define PLAGUE_ATMO_READS_MULTISCATTER
#define PLAGUE_ATMO_READS_SKYVIEW
#moj_import <fornax_runtime:atmo_lut.glsl>

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Bindings: 0 globals, 1 packOptions (engine-injected), 2 atmoTransmittance, 3 atmoMultiScatter,
// 4 atmoSkyView, 5 the table. Storage targets are storage images here, never samplers.
layout(rgba16f, set = 0, binding = 2) uniform readonly image2D u_Transmittance;
layout(rgba16f, set = 0, binding = 3) uniform readonly image2D u_MultiScatter;
layout(rgba16f, set = 0, binding = 4) uniform readonly image2D u_SkyView;
layout(rgba16f, set = 0, binding = 5) uniform writeonly image2D u_OutAerial;

vec4 plagueAtmoFetchTransmittance(vec2 uv) {
    ivec2 i0;
    ivec2 i1;
    vec2 f;
    plagueAtmoBilinearSetup(uv, imageSize(u_Transmittance), i0, i1, f);
    return plagueAtmoBilinearMix(imageLoad(u_Transmittance, i0), imageLoad(u_Transmittance, ivec2(i1.x, i0.y)),
                                 imageLoad(u_Transmittance, ivec2(i0.x, i1.y)), imageLoad(u_Transmittance, i1), f);
}

vec4 plagueAtmoFetchMultiScatter(vec2 uv) {
    ivec2 i0;
    ivec2 i1;
    vec2 f;
    plagueAtmoBilinearSetup(uv, imageSize(u_MultiScatter), i0, i1, f);
    return plagueAtmoBilinearMix(imageLoad(u_MultiScatter, i0), imageLoad(u_MultiScatter, ivec2(i1.x, i0.y)),
                                 imageLoad(u_MultiScatter, ivec2(i0.x, i1.y)), imageLoad(u_MultiScatter, i1), f);
}

vec4 plagueAtmoFetchSkyView(vec2 uv) {
    ivec2 i0;
    ivec2 i1;
    vec2 f;
    plagueAtmoBilinearSetup(uv, imageSize(u_SkyView), i0, i1, f);
    return plagueAtmoBilinearMix(imageLoad(u_SkyView, i0), imageLoad(u_SkyView, ivec2(i1.x, i0.y)),
                                 imageLoad(u_SkyView, ivec2(i0.x, i1.y)), imageLoad(u_SkyView, i1), f);
}

void main() {
    ivec2 size = imageSize(u_OutAerial);
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, size))) {
        return;
    }
    int slice = texel.x / PLAGUE_ATMO_AERIAL_GRID;
    ivec2 cell = ivec2(texel.x - slice * PLAGUE_ATMO_AERIAL_GRID, texel.y);

    // The froxel's ray, reconstructed exactly the way the resolve reconstructs a pixel's: at a
    // far-but-finite reversed-Z depth so view bob stays negligible against the distance.
    vec2 ndc = (vec2(cell) + 0.5) / float(PLAGUE_ATMO_AERIAL_GRID) * 2.0 - 1.0;
    vec4 worldH = u_InvProjModelView * vec4(ndc, 0.0001, 1.0);
    vec3 dir = normalize(worldH.xyz / worldH.w);

    vec3 sunDir = dot(u_SkyCelestial.xyz, u_SkyCelestial.xyz) > 1e-6
            ? normalize(u_SkyCelestial.xyz) : vec3(0.0, 1.0, 0.0);
    float r = plagueAtmoCameraRadius();
    float rain = clamp(u_SkyState.x, 0.0, 1.0);
    float thunder = clamp(u_FrameState.z, 0.0, 1.0);

    if (slice == PLAGUE_ATMO_AERIAL_SKY_SLICE) {
        imageStore(u_OutAerial, texel, plagueAtmoSkyView(dir, sunDir, r));
        return;
    }

    // The fog drive, the way every fog site builds it, for the mist alone: its optical-depth
    // multiplier above one becomes mist density, its moist-layer height the mist's e-folding
    // height. sunDir.y is the sine of the sun's elevation, what the fullscreen sites pass as
    // u_SunDirection.w.
    PlagueLighting lighting = plagueOverworldLighting(max(u_SkyColor.rgb, vec3(0.0)), sunDir.y,
                                                      u_SkyState.y, rain, u_ScreenBrightness);
    PlagueFogDrive drive = PLAGUE_FOG_DRIVE(lighting);
    PlagueAtmoAir air = plagueAtmoAirWithMist(plagueAtmoAir(rain, thunder), drive.tauScale - 1.0,
                                              u_FogDensity, drive.H * (1.0 + drive.rainDepth * drive.rain));

    if (slice == PLAGUE_ATMO_AERIAL_CHROMA_SLICE) {
        imageStore(u_OutAerial, texel,
                   vec4(plagueAtmoTransmittanceChroma(r - PLAGUE_PLANET_RADIUS, air), 1.0));
        return;
    }

    float end = plagueAtmoAerialSliceDepth(slice, plagueAtmoAerialFar()) * PLAGUE_ATMO_METRES_PER_BLOCK;
    vec4 aerial = plagueAtmoMarchTo(vec3(0.0, r, 0.0), dir, sunDir, plagueAtmoSunRadiance(sunDir),
                                    plagueAtmoMoonRadiance(), air, end, PLAGUE_ATMO_AERIAL_STEPS);
    imageStore(u_OutAerial, texel, aerial);
}
