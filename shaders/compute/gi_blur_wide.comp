#version 450

// Second spreading step, taps two cells apart.
//
// Every cell it reads is already an average of its own neighbours, so stepping over the ones in
// between loses nothing and reaches twice as far. The kernel and the reason are in
// gi_blur_kernel.glsl.

#define PLAGUE_GI 0 //[0 1] compile "Bounce Light" {0="Off" 1="On"}
#define FORNAX_COMPUTE_GLOBALS
#define FORNAX_GLOBALS_BINDING 0
#moj_import <fornax:globals.glsl>

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Bindings: 0 globals, 1 packOptions (engine-injected), 2 the once-spread bounce, 3 depth, 4 its
// bearing, then the outputs, 5 the light the frame reads and 6 its bearing.
layout(rgba16f, set = 0, binding = 2) uniform readonly image2D u_Bounce;
layout(set = 0, binding = 3) uniform sampler2D u_Depth;
layout(rgba16f, set = 0, binding = 4) uniform readonly image2D u_Dir;
layout(rgba16f, set = 0, binding = 5) uniform writeonly image2D u_OutBlurred;
layout(rgba16f, set = 0, binding = 6) uniform writeonly image2D u_OutDir;

#moj_import <fornax_runtime:gi_blur_kernel.glsl>

void main() {
    ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
    if (cell.x >= PLAGUE_GI_SIDE || cell.y >= PLAGUE_GI_SIDE) return;
    plagueGiBlurCell(cell, 2);
}
