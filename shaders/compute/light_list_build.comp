#version 450

// Turns the voxel source cells into the engine's list of lights, so a ray can be aimed at one.
//
// The cells and their radiance are already computed for the voxel lighting; this only reshapes
// them. Scanning the world a second time would be the same answer at twice the cost, and two scans
// that drift apart light a room two different ways.
//
// THE ENGINE SETS THIS PASS'S DISPATCH, not graph.toml. It knows the pass by name, and hands it a
// cube of groups covering a camera-centred scan volume, with 4 by 4 by 4 threads to a group. That
// group size is a contract: the engine divides the scan's width by 4 to get the group count, so any
// other local_size covers the wrong volume. A flat 1D layout here fails silently and badly: the
// cube visits each record once along x and again for every y and z, so every light lands in the
// list hundreds of times, the count reaches its cap inside the first few records, and the list ends
// up holding many copies of whichever cells the scan committed first. The list is full, the rays
// are answered, and none of the lights are near the player.
//
// Renaming this pass leaves the list unbuilt with no error anywhere, and frees the buffer too: the
// engine allocates analyticLightList only while a pass by this name is enabled.

#define PLAGUE_GI 0 //[0 1] compile "Bounce Light" {0="Off" 1="On"}
#define FORNAX_COMPUTE_GLOBALS
#define FORNAX_GLOBALS_BINDING 0
#moj_import <fornax:globals.glsl>
#moj_import <fornax_runtime:voxel_local_layout.glsl>
#moj_import <fornax_runtime:gi_lights.glsl>

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// How far from the camera a cell may sit and still reach the list, in blocks. The engine sizes this
// pass's dispatch cube to the same radius.
const float PLAGUE_GI_SCAN_RADIUS = 64.0;

// Bindings: 0 globals, 1 packOptions (engine-injected), 2 the source radiance, 3 the list.
layout(std430, set = 0, binding = 2) readonly buffer LocalRadiance {
    uint words[];
} sources;
layout(std430, set = 0, binding = 3) buffer AnalyticLightList {
    uint words[];
} lights;

void main() {
    // The engine's dispatch is a cube and what this pass walks is a flat list of records, so the
    // three axes fold back into one index. gl_NumWorkGroups is the count the engine chose this
    // frame, which moves with the render distance.
    uvec3 extent = gl_NumWorkGroups * gl_WorkGroupSize;
    uint record = (gl_GlobalInvocationID.z * extent.y + gl_GlobalInvocationID.y) * extent.x
            + gl_GlobalInvocationID.x;
    // A cube narrower than the record count would leave the tail unvisited. The smallest cube the
    // engine dispatches holds more threads than the scan has records, so this is a bound, not a
    // case that runs.
    if (record >= uint(PLAGUE_LOCAL_CAPACITY) || sources.words.length() < PLAGUE_LOCAL_SOURCE_WORDS) {
        return;
    }
    // Word 2 is how many records the scan committed this frame. Past that the array holds an
    // older frame's cells, which are a different world.
    if (record >= sources.words[2]) {
        return;
    }

    int base = PLAGUE_LOCAL_RECORDS + int(record) * PLAGUE_LOCAL_RECORD_WORDS;
    // Word 6 marks a record the scan finished. An unfinished one has a cell but no radiance.
    if (sources.words[base + 6] != 1u) {
        return;
    }

    // Every lit face, every quarter of it. The list carries one light per cell, so what it wants
    // is the total: a glowstone lighting a room through four open faces is four times the light of
    // one buried in a wall.
    uint faces = sources.words[base + 7] & 63u;
    vec3 total = vec3(0.0);
    for (int face = 0; face < 6; ++face) {
        if ((faces & (1u << face)) == 0u) {
            continue;
        }
        for (int quarter = 0; quarter < 4; ++quarter) {
            int quarterBase = base + 8 + face * 16 + quarter * 4;
            vec3 le = uintBitsToFloat(uvec3(sources.words[quarterBase], sources.words[quarterBase + 1u],
                                            sources.words[quarterBase + 2u]));
            // The scan leaves a face it could not read as something that is not a number. Adding
            // one poisons the whole entry, and a light whose colour is not a number reads as no
            // light at all wherever it is used.
            if (any(isnan(le)) || any(isinf(le))) {
                continue;
            }
            total += max(le, vec3(0.0));
        }
    }

    // What the list carries is a point standing in for the block's lit faces, and the number a
    // point needs is the light it throws averaged over every direction. For a flat face that is its
    // area over four, so a block face of one square block averages a quarter. The four quarters
    // above are samples of one such face, not four faces, so they average as well: a quarter of a
    // quarter, one sixteenth of the total. Same result for any number of open faces, since each one
    // contributes its own area over four.
    vec3 intensity = total / 16.0;

    // The strongest channel, so the colour beside it never leaves the 0 to 1 the packing holds and
    // the two multiplied back together are the light itself. Dividing by brightness instead would
    // push a deep red past 1 and clip away most of it.
    float strength = max(intensity.r, max(intensity.g, intensity.b));
    if (!(strength > 0.0)) {
        return;
    }

    // Claim a slot. Past the cap the entry is dropped rather than written somewhere nothing reads,
    // and the count is left at the cap so a reader never walks past the end.
    uint slot = atomicAdd(lights.words[0], 1u);
    if (slot >= PLAGUE_GI_MAX_LIGHTS) {
        atomicMin(lights.words[0], PLAGUE_GI_MAX_LIGHTS);
        return;
    }

    // The list holds window-grid-local blocks: the cell's own coordinates less the grid's first
    // corner. Half a block puts the light at the cell's centre rather than its corner.
    ivec3 cell = ivec3(sources.words[base], sources.words[base + 1u], sources.words[base + 2u]);
    int d = u_VoxelWindow.w;
    ivec3 firstSection = u_VoxelWindow.xyz - ivec3((d - 1) / 2);
    vec3 local = vec3(cell - firstSection * 16) + 0.5;

    // The list holds 256 lights and the scan commits up to 4096 cells across the whole window, so
    // without a cull the cap goes to whichever cells the scan reached first, which can be the far
    // side of the render distance while the room the player stands in gets nothing. Same radius the
    // engine sizes this pass's own dispatch cube to.
    vec3 fromCamera = local + vec3(firstSection) * 16.0 - u_CameraAbs;
    if (dot(fromCamera, fromCamera) > PLAGUE_GI_SCAN_RADIUS * PLAGUE_GI_SCAN_RADIUS) {
        return;
    }

    vec3 colour = clamp(intensity / strength, vec3(0.0), vec3(1.0));
    uint packedColour = uint(colour.r * 1023.0 + 0.5)
            | (uint(colour.g * 1023.0 + 0.5) << 10)
            | (uint(colour.b * 1023.0 + 0.5) << 20);
    // The low byte is the radius in blocks. One cell is one light here, so the count above it is
    // one, in the 4.4 fixed point the layout names.
    uint radiusCount = uint(PLAGUE_LOCAL_REACH) | (16u << 8);

    uint entry = 1u + slot * PLAGUE_GI_LIGHT_WORDS;
    lights.words[entry] = floatBitsToUint(local.x);
    lights.words[entry + 1u] = floatBitsToUint(local.y);
    lights.words[entry + 2u] = floatBitsToUint(local.z);
    lights.words[entry + 3u] = packedColour;
    lights.words[entry + 4u] = radiusCount;
    lights.words[entry + 5u] = floatBitsToUint(strength);
}
