#version 450

// A ray from each cell's surface to one glowing block, so the lamp's shadow gets measured rather
// than guessed.
//
// The light itself is exact and per pixel (voxel_local_direct.fsh). What this grid asks is only
// how much of a lamp a surface can see, one ray a cell a frame: a lamp drawn in proportion to its
// share, aimed at a fresh point on its face. gi_light_resolve averages the answers over frames,
// gi_light_upsample hands the fraction to the voxel chain, and voxel_local_combine multiplies.

#define PLAGUE_LOCAL_SHADOWS 0 //[0 1] compile "Traced Block Light" {0="Off" 1="On"}
#define FORNAX_COMPUTE_GLOBALS
#define FORNAX_GLOBALS_BINDING 0
#moj_import <fornax:globals.glsl>
#moj_import <fornax_runtime:gi_grid.glsl>
#moj_import <fornax_runtime:geometric_normal.glsl>
#define PLAGUE_GI_LIGHT_READER
#moj_import <fornax_runtime:gi_lights.glsl>

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Bindings: 0 globals, 1 packOptions (engine-injected), 2 the light list, 3 depth, 4 gNormal, 5 the
// grid (read only for its own extent), 6 the rays. This pass writes no image itself, so the grid is
// bound purely to read imageSize off it: appended, never inserted, so the rays binding below is the
// only one it moves.
layout(std430, set = 0, binding = 2) readonly buffer AnalyticLightList {
    uint words[];
} lights;
layout(set = 0, binding = 3) uniform sampler2D u_Depth;
layout(set = 0, binding = 4) uniform sampler2D u_GNormal;
layout(rgba16f, set = 0, binding = 5) uniform readonly image2D u_GiGrid;
layout(std430, set = 0, binding = 6) buffer GiLightRequests {
    vec4 words[];
} rays;

// The chooser lives in the include and the list lives here, so this is how it reads one.
uint plagueGiLightWord(uint index) {
    return lights.words[index];
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    ivec2 size = imageSize(u_GiGrid);
    uvec2 gridSize = uvec2(size);
    if (index >= gridSize.x * gridSize.y) return;

    // Row-major on the grid's WIDTH. gi_light_resolve decodes this same index with the width it
    // reads off the same target, so the two must agree or a ray answers the wrong cell.
    vec2 cell = vec2(float(index % gridSize.x), float(index / gridSize.x));
    vec2 uv = plagueGiCellUv(cell, vec2(size));

    float depth = texture(u_Depth, uv).r;
    vec4 packed = texture(u_GNormal, uv);
    // The flat face, decoded from gNormal's alpha, not the bumped normal in its rgb: leaves
    // change their bumped normal texel to texel, which fails the history test's facing check
    // every frame, and the flat face stays the same across a whole leaf block.
    vec3 normal = dot(packed.xyz, packed.xyz) > 1e-6
            ? plagueDecodeGeometricNormal(packed.a, normalize(packed.xyz)) : vec3(0.0);
    uint count = min(lights.words[0], PLAGUE_GI_MAX_LIGHTS);
    // Sky, an unwritten normal, or a frame with no lights at all. A zero-length direction is a
    // caller bug to the engine's kernel, and a tMax of zero is what says this ray wants no trace.
    if (depth <= 0.0 || dot(normal, normal) <= 1e-6 || count == 0u) {
        rays.words[index * 2u] = vec4(0.0);
        rays.words[index * 2u + 1u] = vec4(0.0, 1.0, 0.0, 0.0);
        return;
    }

    vec4 clip = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 world = u_InvProjModelView * clip;
    vec3 surface = world.xyz / world.w;

    // Weighted by what each light would give this cell, so the one ray this cell can afford goes
    // where the light is, and drawn again every frame so every lamp gets its turn.
    PlagueGiPick pick = plagueGiPickLight(surface, normal, count, plagueGiFrameSeed(index));
    vec3 toLight = pick.light.position - surface;
    float distance = length(toLight);
    // Nothing in reach facing this way, or a light the cell sits inside. Neither is a ray worth
    // tracing. A tMax of zero tells gi_light_resolve to count this cell as fully lit.
    if (!pick.valid || !(distance > 1e-3)) {
        rays.words[index * 2u] = vec4(0.0);
        rays.words[index * 2u + 1u] = vec4(0.0, 1.0, 0.0, 0.0);
        return;
    }

    // At a point on the lamp's surface, a different one each frame. The average over frames is
    // the fraction of the lamp this cell can see: a soft edge whose width is set by the lamp's real
    // size and where the blocker stands, not by a number.
    // Lift along the normal to avoid re-hitting the receiver at grazing angles. Aim from that
    // origin too: reusing the old direction translates the segment past its chosen lamp point.
    vec3 origin = surface + normal * 0.03;
    vec3 toTarget = plagueGiLightPoint(index, pick.light) - origin;
    float span = length(toTarget);
    if (!(span > 1e-3)) {
        rays.words[index * 2u] = vec4(0.0);
        rays.words[index * 2u + 1u] = vec4(0.0, 1.0, 0.0, 0.0);
        return;
    }

    vec3 direction = toTarget / span;
    rays.words[index * 2u] = vec4(origin, 0.001);
    rays.words[index * 2u + 1u] = vec4(direction, plagueGiLampReach(origin, direction, span, pick.light));
}
