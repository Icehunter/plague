#version 450

// First spreading step over the bounce grid, one cell apart.
//
// The kernel and the reasons for it live in gi_blur_kernel.glsl. The variance starts here, taken
// from the moments the resolve pass kept beside the raw bounce.

#define PLAGUE_GI 0 //[0 1] compile "Bounce Light (Experimental)" {0="Off" 1="On"}
#define FORNAX_COMPUTE_GLOBALS
#define FORNAX_GLOBALS_BINDING 0
#moj_import <fornax:globals.glsl>

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Bindings: 2 the raw bounce, 3 depth, 4 the raw bearing, 5 the moments from the resolve, 6 the
// surface normal, then the outputs, 7 the bounce and 8 its bearing. Inputs are APPENDED, never
// inserted: an inserted one re-points every binding after it, outputs included, with no error
// anywhere.
layout(rgba16f, set = 0, binding = 2) uniform readonly image2D u_Bounce;
layout(set = 0, binding = 3) uniform sampler2D u_Depth;
layout(rgba16f, set = 0, binding = 4) uniform readonly image2D u_Dir;
layout(rgba16f, set = 0, binding = 5) uniform readonly image2D u_Moments;
layout(set = 0, binding = 6) uniform sampler2D u_GNormal;
layout(rgba16f, set = 0, binding = 7) uniform writeonly image2D u_OutBlurred;
layout(rgba16f, set = 0, binding = 8) uniform writeonly image2D u_OutDir;

#define PLAGUE_GI_HISTORY_DEPTH u_Depth
#define PLAGUE_GI_HISTORY_NORMAL u_GNormal
#moj_import <fornax_runtime:gi_history_test.glsl>
#define PLAGUE_GI_BLUR_FIRST
#moj_import <fornax_runtime:gi_blur_kernel.glsl>

void main() {
    ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
    // Read off the bounce grid itself, so this pass tracks whatever size the trace stage fills it
    // at rather than a number kept in step with graph.toml by hand.
    ivec2 size = imageSize(u_Bounce);
    if (cell.x >= size.x || cell.y >= size.y) return;
    plagueGiBlurCell(cell, 1, size);
}
