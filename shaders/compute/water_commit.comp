#version 450
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) buffer WaterWaveState {
    vec4 committed;
    vec4 frame;
    vec4 control;
    vec4 travel;
    vec4 splash;
} waveState;

void main() {
    waveState.committed.xy = waveState.frame.zw;
}
