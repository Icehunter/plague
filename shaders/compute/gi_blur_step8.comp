#version 450

// Fourth spreading step, eight cells apart.
//
// Last step; its output is what the world resolve reads. The kernel and the reasons live in
// gi_blur_kernel.glsl.

#define PLAGUE_GI 0 //[0 1] compile "Bounce Light (Experimental)" {0="Off" 1="On"}
#define FORNAX_COMPUTE_GLOBALS
#define FORNAX_GLOBALS_BINDING 0
#moj_import <fornax:globals.glsl>

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Bindings: 2 the four-times-spread bounce, its variance riding in alpha, 3 depth, 4 its bearing,
// 5 the surface normal, then the outputs, 6 the final bounce and 7 its bearing. Inputs are
// APPENDED, never inserted: an inserted one re-points every binding after it, outputs included,
// with no error anywhere.
layout(rgba16f, set = 0, binding = 2) uniform readonly image2D u_Bounce;
layout(set = 0, binding = 3) uniform sampler2D u_Depth;
layout(rgba16f, set = 0, binding = 4) uniform readonly image2D u_Dir;
layout(set = 0, binding = 5) uniform sampler2D u_GNormal;
layout(rgba16f, set = 0, binding = 6) uniform writeonly image2D u_OutBlurred;
layout(rgba16f, set = 0, binding = 7) uniform writeonly image2D u_OutDir;

#define PLAGUE_GI_HISTORY_DEPTH u_Depth
#define PLAGUE_GI_HISTORY_NORMAL u_GNormal
#moj_import <fornax_runtime:gi_history_test.glsl>
#moj_import <fornax_runtime:gi_blur_kernel.glsl>

void main() {
    ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
    // Read off the previous step's grid itself, matching the earlier passes rather than a number
    // kept in step with graph.toml by hand.
    ivec2 size = imageSize(u_Bounce);
    if (cell.x >= size.x || cell.y >= size.y) return;
    plagueGiBlurCell(cell, 8, size);
}
