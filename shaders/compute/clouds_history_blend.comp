#version 450
#define FORNAX_COMPUTE_GLOBALS
#define FORNAX_GLOBALS_BINDING 0
#moj_import <fornax:globals.glsl>
#moj_import <fornax_runtime:cloud_history.glsl>
#moj_import <fornax_runtime:cloud_history_state.glsl>
#moj_import <fornax_runtime:cloud_history_read.glsl>

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rgba16f, set = 0, binding = 10) uniform writeonly image2D u_CloudBlend;

#if PLAGUE_CLOUD_TEMPORAL != 0
bool plagueCloudHistoryNeighbourhood(ivec2 pixel, vec2 backward,
                                     out vec4 lower, out vec4 upper, out vec2 distanceRange) {
    lower = imageLoad(u_CurrentCloud, pixel);
    upper = lower;
    distanceRange = vec2(0.0);
    uint mask;
    float stamp;
    if (!plagueCloudHistoryUnpack(imageLoad(u_CurrentData, pixel).r, mask, stamp)
        || stamp != currentHeader.x || !plagueCloudHistorySingle(mask)) return false;
    bool firstTap = true;
    // 3x3 is the smallest symmetric support that includes the diagonal bilinear neighbours.
    // Require the whole support: partial edge footprints cannot establish a colour/depth bound.
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            ivec2 tap = pixel + ivec2(x, y);
            if (any(lessThan(tap, ivec2(0)))
                || any(greaterThanEqual(tap, imageSize(u_CurrentCloud)))) return false;
            uint tapMask;
            float tapStamp;
            if (!plagueCloudHistoryUnpack(imageLoad(u_CurrentData, tap).r, tapMask, tapStamp)
                || tapStamp != currentHeader.x || tapMask != mask) return false;
            vec4 colour = imageLoad(u_CurrentCloud, tap);
            float distance = imageLoad(u_CurrentDistance, tap).r;
            if (!plagueCloudHistoryPremultiplied(colour) || !(distance > 0.0)
                || !plagueCloudHistoryFinite(vec4(distance))) return false;
            vec2 uv = (vec2(tap) + 0.5) / vec2(imageSize(u_CurrentCloud));
            // Same jittered ray as the fresh march; compare all proxies in the previous camera frame.
            vec4 world = u_InvProjModelView * vec4(uv * 2.0 - 1.0, 0.0001, 1.0);
            vec3 ray = normalize(world.xyz / world.w);
            vec3 previousPoint = ray * distance + u_CameraDelta.xyz + vec3(backward.x, 0.0, backward.y);
            float previousDistance = length(previousPoint);
            if (!plagueCloudHistoryFinite(vec4(previousPoint, previousDistance))
                || !(previousDistance > 0.0)) return false;
            lower = min(lower, colour);
            upper = max(upper, colour);
            distanceRange = firstTap ? vec2(previousDistance)
                : vec2(min(distanceRange.x, previousDistance), max(distanceRange.y, previousDistance));
            firstTap = false;
        }
    }
    return true;
}

vec4 plagueCloudHistoryBlend(ivec2 pixel) {
    vec4 fresh = imageLoad(u_CurrentCloud, pixel);
    PlagueCloudHistorySample previous;
    vec3 error;
    if (plagueCloudHistoryCandidate(pixel, error, previous) != 0 || !previous.premultiplied) return fresh;
    vec4 lower, upper;
    vec2 distanceRange;
    if (!plagueCloudHistoryNeighbourhood(pixel, previous.backward, lower, upper, distanceRange)) return fresh;
    float weight = plagueCloudHistoryBlendWeight(fresh, previous.colour, lower, upper,
                                                previous.distanceRange, distanceRange);
    // Rejection preserves the exact fresh value, including invalid inputs; never mix NaN with zero weight.
    if (!(weight > 0.0)) return fresh;
    return mix(fresh, previous.colour, weight);
}
#endif

void main() {
#if PLAGUE_CLOUD_TEMPORAL != 0
    if (gl_LocalInvocationIndex == 0u) plagueCloudHistoryCheckFrame();
    barrier();
#endif
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(u_CloudBlend)))) return;
#if PLAGUE_CLOUD_TEMPORAL != 0
    vec4 colour = plagueCloudHistoryBlend(pixel);
#else
    vec4 colour = imageLoad(u_CurrentCloud, pixel);
#endif
    // Only the display colour is published. Raw history and the fresh distance remain unchanged.
    imageStore(u_CloudBlend, pixel, colour);
}
