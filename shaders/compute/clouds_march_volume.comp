#version 450
// March one genus per workgroup, avoiding seven live colour/front results in the march's private
// working set. Float32 layer targets preserve march precision until the final merge.
#define PLAGUE_CLOUD_CANDIDATE_CACHE_READ
#moj_import <fornax_runtime:cloud_volume_frame.glsl>
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Seven interleaved colour/front pairs, in the original genus order.
// dispatch.z MUST be seven: an omitted genus leaves stale pixels. Every disabled or missed genus
// must overwrite its own targets with zero on every dispatch.
layout(rgba32f, set = 0, binding = 8) uniform writeonly image2D u_CloudLayer0Colour;
layout(r32f, set = 0, binding = 9) uniform writeonly image2D u_CloudLayer0Front;
layout(rgba32f, set = 0, binding = 10) uniform writeonly image2D u_CloudLayer1Colour;
layout(r32f, set = 0, binding = 11) uniform writeonly image2D u_CloudLayer1Front;
layout(rgba32f, set = 0, binding = 12) uniform writeonly image2D u_CloudLayer2Colour;
layout(r32f, set = 0, binding = 13) uniform writeonly image2D u_CloudLayer2Front;
layout(rgba32f, set = 0, binding = 14) uniform writeonly image2D u_CloudLayer3Colour;
layout(r32f, set = 0, binding = 15) uniform writeonly image2D u_CloudLayer3Front;
layout(rgba32f, set = 0, binding = 16) uniform writeonly image2D u_CloudLayer4Colour;
layout(r32f, set = 0, binding = 17) uniform writeonly image2D u_CloudLayer4Front;
layout(rgba32f, set = 0, binding = 18) uniform writeonly image2D u_CloudLayer5Colour;
layout(r32f, set = 0, binding = 19) uniform writeonly image2D u_CloudLayer5Front;
layout(rgba32f, set = 0, binding = 20) uniform writeonly image2D u_CloudLayer6Colour;
layout(r32f, set = 0, binding = 21) uniform writeonly image2D u_CloudLayer6Front;

// Each workgroup owns one genus. Constant image writes preserve the positional output ABI
// without descriptor-array indexing; all fourteen targets use the same native pixel dimensions.
void plagueStoreCloudLayer(int index, ivec2 pixel, vec4 colour, float front) {
    switch (index) {
        case 0:
            imageStore(u_CloudLayer0Colour, pixel, colour);
            imageStore(u_CloudLayer0Front, pixel, vec4(front));
            break;
        case 1:
            imageStore(u_CloudLayer1Colour, pixel, colour);
            imageStore(u_CloudLayer1Front, pixel, vec4(front));
            break;
        case 2:
            imageStore(u_CloudLayer2Colour, pixel, colour);
            imageStore(u_CloudLayer2Front, pixel, vec4(front));
            break;
        case 3:
            imageStore(u_CloudLayer3Colour, pixel, colour);
            imageStore(u_CloudLayer3Front, pixel, vec4(front));
            break;
        case 4:
            imageStore(u_CloudLayer4Colour, pixel, colour);
            imageStore(u_CloudLayer4Front, pixel, vec4(front));
            break;
        case 5:
            imageStore(u_CloudLayer5Colour, pixel, colour);
            imageStore(u_CloudLayer5Front, pixel, vec4(front));
            break;
        case 6:
            imageStore(u_CloudLayer6Colour, pixel, colour);
            imageStore(u_CloudLayer6Front, pixel, vec4(front));
            break;
    }
}

void main() {
#if CLOUDS_VOLUMETRIC
    if (gl_LocalInvocationIndex == 0u && u_SkyState.z > 0.5) {
        plaguePrepareCloudWorkgroup();
    }
    // Edge invocations must also reach this barrier. Returning early on bounds can stall the group.
    barrier();
#endif
    // First output dimensions also drive the engine's x/y dispatch counts.
    ivec2 outSize = imageSize(u_CloudLayer0Colour);
    int cloudIndex = int(gl_WorkGroupID.z);
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texelCoord, outSize))) {
        return;
    }
#if CLOUDS_VOLUMETRIC
    vec2 texCoord = (vec2(texelCoord) + 0.5) / vec2(outSize);

    if (u_SkyState.z <= 0.5) {
        plagueStoreCloudLayer(cloudIndex, texelCoord, vec4(0.0), 0.0);
        return;
    }

    // Reconstruct at the reversed-Z far plane: the near plane puts the point centimeters from the
    // eye, where view-bob swings the direction tens of degrees per footstep.
    vec4 clipPos = vec4(texCoord * 2.0 - 1.0, 0.0001, 1.0);
    vec4 worldH = u_InvProjModelView * clipPos;
    vec3 viewDir = normalize(worldH.xyz / worldH.w);

    const float goldenRatio = 1.61803398875;
    float dither = 52.9829189
            * fract(0.06711056 * float(texelCoord.x) + 0.00583715 * float(texelCoord.y));
    // Older engines omit FX_* from compute: preserve their existing sequence until updated.
#if !defined(FX_TAA) || FX_TAA != 0 || PLAGUE_CLOUD_TEMPORAL != 0
    dither = fract(dither + goldenRatio * mod(u_FrameState.x, 3600.0));
#else
    // With no temporal consumer, changing the sample each frame only makes it flicker.
    // Keep spatial dither; this does not filter aliasing during camera or cloud movement.
    dither = fract(dither);
#endif

    // The cutoff colour is directional, so each ray keeps its own sky lookup and grading.
    vec3 skyAlong = plagueAtmoSkyView(viewDir, sunDirTrue, plagueAtmoCameraRadius()).rgb;
    skyAlong = plagueWarmSkyBand(skyAlong, viewDir.y, dot(viewDir, sunDirTrue), sunDirTrue.y);
    skyAlong = plagueStormDarkenSky(skyAlong, viewDir.y, dot(viewDir, sunDirTrue), sunDirTrue.y,
                                    localRain, localThunder) * atmColorMult;

    vec4 selectedLayer = vec4(0.0);
    float selectedFront = 0.0;

    PlagueCloudDeck deck;
    float phase = dither;
    bool enabled;
    if (cloudIndex == 0) {
        deck = convectiveDeck;
        enabled = cumulusOn > 0.0 && stratiform < 1.0;
    } else if (cloudIndex == 1) {
        deck = sheetDeck;
        phase = fract(dither + 0.3333);
        enabled = lowSheet > 0.0;
    } else if (cloudIndex == 2) {
        deck = stratiformDeck;
        phase = fract(dither + 0.6667);
        enabled = rainOn > 0.0 && stratiform > 0.0;
    } else if (cloudIndex == 3) {
        deck = rollDeck;
        phase = fract(dither + 0.1667);
        enabled = lowRolls > 0.0;
    } else if (cloudIndex == 4) {
        deck = altocumulusDeck;
        phase = fract(dither + 0.5);
        enabled = upperMasks.z > 0.0;
    } else if (cloudIndex == 5) {
        deck = cirrocumulusDeck;
        phase = fract(dither + 0.8333);
        enabled = upperMasks.y > 0.0;
    } else {
        deck = cirrusDeck;
        phase = fract(dither + 0.25);
        enabled = upperMasks.x > 0.0;
    }
    if (enabled) {
        plagueCloudCandidateDeckIndex = cloudIndex;
        selectedLayer = plagueGetClouds(viewDir, u_CameraAbs, 0.0, phase,
                deck, ambientDome, skyAlong, lighting, sunDirTrue, syncedTime,
                renderDistance, selectedFront);
        if (cloudIndex == 0) selectedLayer *= 1.0 - stratiform;
    }
    plagueStoreCloudLayer(cloudIndex, texelCoord, selectedLayer, selectedFront);
#else
    plagueStoreCloudLayer(cloudIndex, texelCoord, vec4(0.0), 0.0);
#endif
}
